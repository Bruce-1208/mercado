# 默认无头采集；遇到验证码时可临时改为 false，在可见浏览器中手动完成验证。
YANDEX_HEADLESS=true

# 服务监听地址和端口
YANDEX_HOST=127.0.0.1
YANDEX_PORT=8000

# 抓取间隔，单位为毫秒。请勿设得过低。
YANDEX_REQUEST_DELAY_MS=1200

# 商品详情采集默认使用 6 个无头 Chromium；可按机器内存设为 1–12。
YANDEX_SCRAPER_PROCESSES=6
YANDEX_WORKER_HEADLESS=true

# 单次允许抓取的最大国外商品数
YANDEX_MAX_PRODUCTS=500

# 订单后台同步：新订单每 15 分钟发现一次；已存在订单状态每 12 小时刷新一次。
# 新订单轮询只插入新订单，不会提高老订单状态的刷新频率。
YANDEX_NEW_ORDER_SYNC_SECONDS=900
YANDEX_OLD_ORDER_STATUS_SYNC_SECONDS=43200
# 调度器检查到期任务的频率；通常无需修改。设 YANDEX_ORDER_SYNC_DISABLED=true 可停用。
YANDEX_ORDER_SYNC_POLL_SECONDS=30
# 单店同步失败后 5 分钟再由后台重试，避免持续请求上游。
YANDEX_ORDER_SYNC_RETRY_SECONDS=300
YANDEX_ORDER_SYNC_DISABLED=false

# 浏览器语言和地区
YANDEX_LOCALE=ru-RU
YANDEX_TIMEZONE=Europe/Moscow

# 订单缓存、同步状态、搜索商品和上传任务的本机数据库位置；不保存店铺授权。
YANDEX_DB_PATH=.data/yandex_reseller.db

# 店铺授权统一保存在中央 MySQL。留空时复用项目 bit.bit_mysql 的连接配置。
YANDEX_MYSQL_HOST=
YANDEX_MYSQL_PORT=
YANDEX_MYSQL_USER=
YANDEX_MYSQL_PASSWORD=
YANDEX_MYSQL_DATABASE=

# 武汉泽顺店铺授权入口。可使用 {tg_code} 占位符；未包含占位符时，
# 程序会自动追加 tg_code 查询参数。也可以在新增授权店铺时单独填写授权链接。
ZESHUN_AUTHORIZATION_URL_TEMPLATE=
