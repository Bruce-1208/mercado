@@ -0,0 +1,58 @@
+"""Optional, database-maintained pack text for exact existing LIKE semantics.
+
+No request performs DDL. Deploy the maintenance script during a write pause;
+unmigrated databases keep the original JSON expression.
+"""
+import re
+import threading
+import time
+
+import pymysql
+
+TABLE = "mercado_synced_orders"
+COLUMN = "_pack_search_value"
+EXPRESSION = "NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`raw_json`, '$.pack_id')), 'null')"
+DEFINITION = ("LONGTEXT CHARACTER SET utf8mb4 COLLATE utf8mb4_bin "
+              f"GENERATED ALWAYS AS ({EXPRESSION}) STORED")
+_CACHE = {}
+_LOCK = threading.Lock()
+
+
+def normalized(expression):
+    # INFORMATION_SCHEMA may escape quotes and add charset introducers. Keep
+    # quoted JSON paths/literals case-sensitive, including their whitespace.
+    tokens = re.findall(r"'(?:''|[^'])*'|`[^`]*`|[A-Za-z_][A-Za-z_0-9]*|\S",
+                        str(expression).replace("\\'", "'"))
+    return tuple(token if token.startswith("'") else token.strip("`").lower()
+                 for token in tokens if token.lower() != "_utf8mb4")
+
+
+def inspect(cursor):
+    cursor.execute(
+        "SELECT GENERATION_EXPRESSION, DATA_TYPE, COLLATION_NAME, EXTRA "
+        "FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() "
+        "AND TABLE_NAME=%s AND COLUMN_NAME=%s", (TABLE, COLUMN))
+    row = cursor.fetchone()
+    if row and (normalized(row["GENERATION_EXPRESSION"]) != normalized(EXPRESSION)
+                or row["DATA_TYPE"] != "longtext"
+                or row["COLLATION_NAME"] != "utf8mb4_bin"
+                or "STORED GENERATED" not in row["EXTRA"]):
+        raise ValueError("Order search projection has an incompatible definition")
+    return bool(row)
+
+
+def pack_sql(cursor):
+    fallback = EXPRESSION.replace("`raw_json`", "synced.`raw_json`")
+    connection = getattr(cursor, "connection", None)
+    if not isinstance(connection, pymysql.connections.Connection):
+        return fallback
+    key = (connection.host, connection.port, connection.unix_socket,
+           connection.user, connection.db)
+    with _LOCK:
+        expires, present = _CACHE.get(key, (0, False))
+        if expires <= time.monotonic():
+            present = inspect(cursor)
+            if len(_CACHE) >= 32:
+                _CACHE.clear()
+            _CACHE[key] = (time.monotonic() + 60, present)
+    return f"synced.`{COLUMN}`" if present else fallback
--- before/scripts/optimize_order_search_projection.py
+++ scripts/optimize_order_search_projection.py
@@ -0,0 +1,52 @@
+"""Inspect order search projection; --apply requires a planned write pause.
+
+MySQL rebuilds the table for a STORED generated column. This script never runs
+from an HTTP request. Reads remain available, but writes pause during COPY;
+allow disk space for a second copy of the table. Existing rows and subsequent
+raw_json updates are maintained by MySQL, without backfill freshness gaps.
+
+python -m scripts.optimize_order_search_projection --database NAME [--apply]
+"""
+import argparse
+import json
+import time
+
+from bit.order_search_projection import COLUMN, DEFINITION, TABLE, inspect
+
+
+def optimize(connection, *, database, apply=False):
+    with connection.cursor() as cursor:
+        cursor.execute("SELECT DATABASE() AS db")
+        actual = cursor.fetchone()["db"]
+        if actual != database or actual in {"mysql", "sys", "information_schema", "performance_schema"}:
+            raise ValueError("Explicit application database must match the connection")
+        cursor.execute("SET SESSION lock_wait_timeout=5")
+        before = inspect(cursor)
+        start = time.monotonic()
+        if apply and not before:
+            cursor.execute(f"ALTER TABLE `{TABLE}` ADD COLUMN `{COLUMN}` {DEFINITION}, "
+                           "ALGORITHM=COPY, LOCK=SHARED")
+        return {"database": actual, "present_before": before,
+                "present_after": inspect(cursor), "applied": bool(apply and not before),
+                "elapsed_seconds": round(time.monotonic() - start, 3),
+                "deployment_requirement": "COPY rebuild: pause writes and reserve table-copy disk space"}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--database", required=True)
+    parser.add_argument("--apply", action="store_true")
+    args = parser.parse_args()
+    import pymysql
+    from bit.db_pool import default_connection_config
+    config = default_connection_config()
+    config.update(autocommit=True, read_timeout=1800)
+    connection = pymysql.connect(**config)
+    try:
+        print(json.dumps(optimize(connection, database=args.database, apply=args.apply)))
+    finally:
+        connection.close()
+
+
+if __name__ == "__main__":
+    main()
