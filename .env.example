DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Mercado Libre Global Selling API
MELI_SELLER_ID=your_marketplace_seller_id
MELI_LISTING_USER_ID=your_cbt_merchant_or_marketplace_seller_id
MELI_ACCESS_TOKEN=your_access_token
MELI_REFRESH_TOKEN=your_refresh_token
MELI_CLIENT_ID=your_app_id
MELI_CLIENT_SECRET=your_app_secret
MELI_DATABASE_PATH=mercado_api/mercado.sqlite3
MELI_TOKEN_FILE=mercado_api/tokens.json
MELI_SYNC_INTERVAL_MINUTES=30

# 数据库访问：Windows 客户端通常使用 api，数据库服务端使用 mysql
BIT_DB_MODE=api
BIT_DB_API_BASE_URL=http://your-database-api-host
BIT_DB_API_TOKEN=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mercado
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=mercado

# 也可以把 key 单独写到项目根目录 deepseek_key.txt 或 AI_Agent/deepseek_key.txt
