DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Mercado Libre Global Selling API
MELI_SELLER_ID=your_marketplace_seller_id
MELI_LISTING_USER_ID=your_cbt_merchant_or_marketplace_seller_id
MELI_ACCESS_TOKEN=your_access_token
MELI_REFRESH_TOKEN=your_refresh_token
MELI_CLIENT_ID=your_app_id
MELI_CLIENT_SECRET=your_app_secret
MELI_REDIRECT_URI=https://your-console-host/zs
MELI_AUTHORIZATION_URL=https://global-selling.mercadolibre.com/authorization
MELI_DATABASE_PATH=mercado_api/mercado.sqlite3
MELI_TOKEN_FILE=mercado_api/tokens.json
MELI_SYNC_INTERVAL_MINUTES=30

# 新订单随工作台 15 分钟订单同步自动生成面单；设为 1 可关闭。
MERCADO_ORDER_AUTO_PRINT_DISABLED=0
# 历史未终态运单每天按北京时间执行全量状态刷新，默认凌晨 2 点。
MERCADO_ORDER_DAILY_STATUS_HOUR=2
# 首次启用只回看最近 15 分钟，防止历史订单被批量重打。
MERCADO_ORDER_AUTO_PRINT_BOOTSTRAP_LOOKBACK_SECONDS=900

# 工作台角色：server 直连 192.168.1.11，client 只访问下面的 HTTPS 接口。
# 每台电脑都可以独立设置；也可在启动时用 --role server/client 临时覆盖。
BIT_RUNTIME_ROLE=server
BIT_DB_API_BASE_URL=https://zeshun.cc.cd
# 测试/备用服务端设为 1：保留接口与手动操作，但不启动任何自动后台调度。
BIT_BACKGROUND_SERVICES_DISABLED=0
# 生产服务关闭 Werkzeug 源码重载；Agent 业务包仍会直接检测磁盘源码变化。
BIT_INTERFACE_HOT_RELOAD=0
# 数据接口的共享令牌；留空时本机连接凭证改由服务端登录密钥签发并在线验证。
# 在线验证要求客户端的 BIT_DB_API_BASE_URL 使用 HTTPS，数据接口权限仍独立校验。
BIT_DB_API_TOKEN=replace-with-the-same-long-random-token-on-server-and-clients
# 公网控制台地址；用于生成本机 Agent 下载包和回连配置。
BIT_PUBLIC_WORKBENCH_URL=https://zeshun.cc.cd
# Agent 在线判定与队列数据库；默认值通常无需修改。
BIT_LOCAL_AGENT_ONLINE_SECONDS=45
# 可选；默认使用与代码部署目录无关的用户数据目录。生产环境如指定，必须使用固定绝对路径。
BIT_LOCAL_AGENT_HUB_PATH=
# 任务模块历史与服务器日志默认保留 3 天。
BIT_DAILY_TASK_LOG_RETENTION_DAYS=3
# 可选：Windows 构建机产出的 EXE 绝对路径；默认读取 dist/MercadoLocalAgent.exe。
BIT_LOCAL_AGENT_EXECUTABLE=
# 可选的共享 Agent 注册令牌；通常留空，改用控制台下载包中的短时注册凭证。
BIT_LOCAL_AGENT_TOKEN=
# 以下两项只供旧版浏览器直连 client 工作台兼容使用。
BIT_LOCAL_EXECUTOR_URL=http://127.0.0.1:5000
# 多个来源用英文逗号分隔；本机执行端只接受这些网页来源和回环地址请求。
BIT_LOCAL_EXECUTOR_ALLOWED_ORIGINS=https://zeshun.cc.cd
MYSQL_HOST=192.168.1.11
MYSQL_PORT=3306
MYSQL_USER=mercado
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=mercado

# 工作台 Mercado 自动翻页采集：页面可选本地 Edge 或比特窗口。
# 默认比特窗口为“采集专用（墨西哥）”；也可在工作台直接改选其他窗口。
MERCADO_COLLECTION_BROWSER=bitbrowser
MERCADO_COLLECTION_WINDOW_NAME=采集专用（墨西哥）
BIT_ZYING_WINDOW_ID=e27ab66368b141a993f9c6847f51222b
BIT_ZYING_WINDOW_NAME=采集专用（墨西哥）
# 选择本地 Edge 时使用以下远程调试地址；工作台可自动打开独立 Edge 登录窗口。
MERCADO_PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222
MERCADO_PLAYWRIGHT_PROFILE_DIR=cache/mercado_playwright_profile
MERCADO_PLAYWRIGHT_HEADLESS=0
MERCADO_PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=35000
# 列表页等待智赢一次批量重量/尺寸结果的最长秒数；不会打开商品详情页。
MERCADO_PLAYWRIGHT_LISTING_PLUGIN_TIMEOUT_SECONDS=6
# 商品费用每 5 分钟检查；美元汇率使用数据库固定值并由后台每 24 小时更新
MERCADO_PROFIT_STALE_HOURS=24
MERCADO_PROFIT_REFRESH_SECONDS=300
MERCADO_PROFIT_REFRESH_BATCH=20
MERCADO_PROFIT_REFRESH_WORKERS=8

# 单个服务进程的共享 MySQL 连接池；close() 会归还连接而不反复建立 TCP 连接。
MYSQL_POOL_MAX_CONNECTIONS=24
MYSQL_POOL_MIN_CACHED=2
MYSQL_POOL_MAX_CACHED=12
MYSQL_POOL_MAX_USAGE=1000
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=120
MYSQL_WRITE_TIMEOUT=120

# 面向约 100 名普通 Web 用户的单进程 Waitress 基线。
BIT_WSGI_THREADS=32
BIT_WSGI_CONNECTION_LIMIT=500

# 链接自动/手动同步：店铺并发 × 每家详情并发，默认最多 512 个详情线程。
MERCADO_STORE_LINK_STORE_WORKERS=16
MERCADO_STORE_LINK_DETAIL_WORKERS=32
MERCADO_STORE_LINK_WRITE_BATCH_SIZE=200
MERCADO_API_HTTP_POOL_SIZE=64
MERCADO_STORE_LINK_REMOTE_UPDATE_WORKERS=16
# 订单自动/手动同步和每日状态刷新：默认 8 家店铺，每家 16 个详情线程。
# 店铺最多 24，详情和图片/费用回填最多 32。
MERCADO_ORDER_STORE_WORKERS=8
MERCADO_ORDER_STATUS_WORKERS=16
MERCADO_API_BACKFILL_WORKERS=16
# 三个风险总览固定每 12 小时全量更新；店铺最多 24，详情最多 32。
MERCADO_INFRACTION_STORE_WORKERS=12
MERCADO_INFRACTION_DETAIL_WORKERS=16
MERCADO_PROHIBITED_STORE_WORKERS=12
MERCADO_PROHIBITED_DETAIL_WORKERS=16

# 快递100企业实时轨迹接口；未配置时仍可跳转快递100官网查询
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=

# 也可以把 key 单独写到项目根目录 deepseek_key.txt 或 AI_Agent/deepseek_key.txt

# 普通 AI 客服申诉不调用 DeepSeek；只有手动选择“AI话术模式”并填写 Token 时调用。
BIT_AI_SEND_CONFIRM_TIMEOUT_SECONDS=30
# 单站点协作式时间预算（秒）；不能强行中断正在执行的底层驱动调用。
BIT_AI_SITE_BUDGET_SECONDS=7200
# 每个会话最多处理的分组数；超时/发送不确定后的下一组强制新会话。
BIT_AI_GROUPS_PER_CONVERSATION=3

# 自动申诉邮件汇总：服务端按北京时间每天 10:00、14:00 发送最近 6 小时执行情况。
BIT_APPEAL_REPORT_ENABLED=1
BIT_APPEAL_REPORT_SEND_HOURS=10,14
BIT_APPEAL_REPORT_RECIPIENT=1013459852@qq.com
