{
  "manifest_version": 3,
  "name": "泽顺插件",
  "version": "1.3.0",
  "description": "在 Mercado Libre、1688 与智赢产品页采集商品，并同步采购订单物流号到泽顺控制台。",
  "permissions": [
    "alarms",
    "contextMenus",
    "cookies",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.1688.com/*",
    "https://*.alicdn.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.yangkeduo.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.goofish.com/*",
    "https://*.xianyu.com/*",
    "https://meli.zying.net/*",
    "https://seller.zying.net/*",
    "https://*.mercadolibre.com.mx/*",
    "https://*.mercadolibre.com.br/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com.ar/*",
    "https://*.mercadolibre.cl/*",
    "https://*.mercadolibre.com.co/*",
    "https://*.mercadolibre.com.uy/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "泽顺商品采集助手",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolibre.com.mx/*",
        "https://*.mercadolibre.com.br/*",
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com.ar/*",
        "https://*.mercadolibre.cl/*",
        "https://*.mercadolibre.com.co/*",
        "https://*.mercadolibre.com.uy/*"
      ],
      "js": [
        "collector-core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.1688.com/*"
      ],
      "js": [
        "content-1688.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meli.zying.net/*"
      ],
      "js": [
        "content-zying.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.1688.com/*",
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.yangkeduo.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.goofish.com/*",
        "https://*.xianyu.com/*"
      ],
      "js": [
        "purchase-tracking-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
