{
  "manifest_version": 3,
  "name": "泽顺插件",
  "version": "1.8.62",
  "description": "采集 Mercado Libre、Yandex、1688 与智赢商品，自动化申诉，检查侵权风险，按日期同步智赢订单与采购物流号。",
  "permissions": [
    "alarms",
    "contextMenus",
    "debugger",
    "cookies",
    "scripting",
    "storage",
    "tabs",
    "windows",
    "webNavigation"
  ],
  "host_permissions": [
    "https://wuhanzeshun.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.1688.com/*",
    "https://*.alicdn.com/*",
    "https://*.mlstatic.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.yangkeduo.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.goofish.com/*",
    "https://*.xianyu.com/*",
    "https://meli.zying.net/*",
    "https://seller.zying.net/*",
    "https://*.hzzying.com/*",
    "https://*.mercadolibre.com.mx/*",
    "https://*.mercadolibre.com.br/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com.ar/*",
    "https://*.mercadolibre.cl/*",
    "https://*.mercadolibre.com.co/*",
    "https://*.mercadolibre.com.uy/*",
    "https://global-selling.mercadolibre.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://*.mercadolibre.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "泽顺插件",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "open-zeshun": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "MacCtrl+Shift+Z"
      },
      "description": "打开泽顺插件"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://*.1688.com/*",
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.yangkeduo.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.goofish.com/*",
        "https://*.xianyu.com/*",
        "https://meli.zying.net/*",
        "https://seller.zying.net/*",
        "https://*.mercadolibre.com.mx/*",
        "https://*.mercadolibre.com.br/*",
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com.ar/*",
        "https://*.mercadolibre.cl/*",
        "https://*.mercadolibre.com.co/*",
        "https://*.mercadolibre.com.uy/*",
        "https://global-selling.mercadolibre.com/*",
        "https://sellers.mercadolibre.com/*"
      ],
      "js": [
        "launcher.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.mercadolibre.com.mx/*",
        "https://*.mercadolibre.com.br/*",
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com.ar/*",
        "https://*.mercadolibre.cl/*",
        "https://*.mercadolibre.com.co/*",
        "https://*.mercadolibre.com.uy/*"
      ],
      "js": [
        "collector-core.js",
        "mercado-data.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.1688.com/*"
      ],
      "js": [
        "content-1688.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meli.zying.net/*"
      ],
      "js": [
        "zying-page.js",
        "content-zying.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.1688.com/*",
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.yangkeduo.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.goofish.com/*",
        "https://*.xianyu.com/*"
      ],
      "js": [
        "purchase-tracking-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.png"
      ],
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://*.1688.com/*",
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.yangkeduo.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.goofish.com/*",
        "https://*.xianyu.com/*",
        "https://meli.zying.net/*",
        "https://seller.zying.net/*",
        "https://*.mercadolibre.com.mx/*",
        "https://*.mercadolibre.com.br/*",
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com.ar/*",
        "https://*.mercadolibre.cl/*",
        "https://*.mercadolibre.com.co/*",
        "https://*.mercadolibre.com.uy/*",
        "https://global-selling.mercadolibre.com/*",
        "https://sellers.mercadolibre.com/*"
      ]
    }
  ]
}
