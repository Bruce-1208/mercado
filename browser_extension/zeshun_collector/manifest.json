{
  "manifest_version": 3,
  "name": "泽顺插件",
  "version": "1.6.0",
  "description": "采集 Mercado Libre Internacional、1688 与智赢商品，检查智赢产品侵权风险，启动 AI 核重核价，并同步采购订单物流号。",
  "permissions": [
    "alarms",
    "contextMenus",
    "cookies",
    "scripting",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.1688.com/*",
    "https://*.alicdn.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.yangkeduo.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.goofish.com/*",
    "https://*.xianyu.com/*",
    "https://meli.zying.net/*",
    "https://seller.zying.net/*",
    "https://*.mercadolibre.com.mx/*",
    "https://*.mercadolibre.com.br/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com.ar/*",
    "https://*.mercadolibre.cl/*",
    "https://*.mercadolibre.com.co/*",
    "https://*.mercadolibre.com.uy/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "泽顺美客多采集助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolibre.com.mx/*",
        "https://*.mercadolibre.com.br/*",
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com.ar/*",
        "https://*.mercadolibre.cl/*",
        "https://*.mercadolibre.com.co/*",
        "https://*.mercadolibre.com.uy/*"
      ],
      "js": [
        "collector-core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.1688.com/*"
      ],
      "js": [
        "content-1688.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meli.zying.net/*"
      ],
      "js": [
        "zying-page.js",
        "content-zying.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.1688.com/*",
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.yangkeduo.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.goofish.com/*",
        "https://*.xianyu.com/*"
      ],
      "js": [
        "purchase-tracking-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
